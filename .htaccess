# Apache configuration for the public site.
# Shared cPanel hosting reads this automatically. On nginx, see the
# "Hosting on nginx" section of README.md for the equivalent rules.

# ---- Default document -------------------------------------------------------
DirectoryIndex index.php index.html

# ---- Hide dotfiles and data ------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # The admin panel must never be indexed or cached by a shared proxy.
    <FilesMatch "^(login|setup|logout)\.php$">
        Header always set Cache-Control "no-store, max-age=0"
    </FilesMatch>
</IfModule>

# ---- Cache static assets ---------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
</IfModule>

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json
</IfModule>

# ---- Force HTTPS -----------------------------------------------------------
# The admin panel sends a password, so serve it over HTTPS. Uncomment once your
# host has issued a certificate (cPanel: "SSL/TLS Status" → AutoSSL).
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
